    void addEmployee(){

        StringBuilder error=new StringBuilder();

        boolean nameErr=false,idErr=false,emailErr=false,
                stateErr=false,districtErr=false,streetErr=false,
                pinErr=false,ageErr=false,expErr=false,
                managerErr=false;   

        if(name.getText().isEmpty() || !name.getText().matches("[A-Za-z ]+")){
            error.append("Name alphabets only and not empty\n");
            nameErr=true;
        }

        if(!id.getText().matches("EMP\\d+")){
            error.append("ID must be CAPITAL EMP followed by numbers\n");
            idErr=true;
        }

        if(email.getText().isEmpty() ||
                !Pattern.matches("^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$",email.getText())){
            error.append("Invalid Email\n");
            emailErr=true;
        }

        if(age.getText().isEmpty()){
            error.append("Age cannot be empty\n");
            ageErr=true;
        } else if(!age.getText().matches("\\d+")){
            error.append("Age numbers only\n");
            ageErr=true;
        }

        if(exp.getText().isEmpty()){
            error.append("Experience cannot be empty\n");
            expErr=true;
        } else if(!exp.getText().matches("\\d+")){
            error.append("Experience numbers only\n");
            expErr=true;
        }

        if(street.getText().isEmpty() || !street.getText().matches("[A-Za-z ]+")){
            error.append("Street alphabets only\n");
            streetErr=true;
        }

        if(state.getText().isEmpty() || !state.getText().matches("[A-Za-z ]+")){
            error.append("State alphabets only\n");
            stateErr=true;
        }

        if(district.getText().isEmpty() || !district.getText().matches("[A-Za-z ]+")){
            error.append("District alphabets only\n");
            districtErr=true;
        }

        if(!pincode.getText().matches("\\d{6}")){
            error.append("Pincode must be 6 digits\n");
            pinErr=true;
        }
        boolean dateErr=false;

        if(doj.getText().isEmpty()){
            error.append("Date cannot be empty (YYYY-MM-DD)\n");
            dateErr=true;
        }else{
            try{
                java.sql.Date.valueOf(doj.getText());
            }catch(Exception e){
                error.append("Invalid Date format (YYYY-MM-DD)\n");
                dateErr=true;
            }
        }
    
        if(!manager.getText().isEmpty() && !manager.getText().matches("EMP\\d+")){
            error.append("Manager ID must be EMP followed by numbers\n");
            managerErr=true;
        }
        if(error.length()>0){
            JOptionPane.showMessageDialog(this,error.toString());

            if(nameErr) name.setText("");
            if(idErr) id.setText("");
            if(emailErr) email.setText("");
            if(ageErr) age.setText("");
            if(expErr) exp.setText("");
            if(streetErr) street.setText("");
            if(stateErr) state.setText("");
            if(districtErr) district.setText("");
            if(pinErr) pincode.setText("");
            if(dateErr) doj.setText("");
            if(managerErr) manager.setText("");
            return;
        }

        try{
            Connection con=DBConnection.getConnection();

            PreparedStatement checkID=con.prepareStatement(
                    "select * from employee where employee_id=?");
            checkID.setString(1,id.getText());
            ResultSet rs1=checkID.executeQuery();

            if(rs1.next()){
                JOptionPane.showMessageDialog(this,"Duplicate Employee ID not allowed");
                id.setText("");
                return;
            }

            PreparedStatement checkEmail=con.prepareStatement(
                    "select * from employee where email=?");
            checkEmail.setString(1,email.getText());
            ResultSet rs2=checkEmail.executeQuery();

            if(rs2.next()){
                JOptionPane.showMessageDialog(this,"Duplicate Email not allowed");
                email.setText("");
                return;
            }

            PreparedStatement ps=con.prepareStatement(
                    "insert into employee values(?,?,?,?,?,?,?,?,?,?,?)");

            ps.setString(1,name.getText());
            ps.setString(2,id.getText());
            ps.setString(3,email.getText());
            ps.setInt(4,Integer.parseInt(age.getText()));
            ps.setInt(5,Integer.parseInt(exp.getText()));
            ps.setString(6,street.getText());
            ps.setString(7,state.getText());
            ps.setString(8,district.getText());
            ps.setInt(9,Integer.parseInt(pincode.getText()));
            ps.setDate(10,java.sql.Date.valueOf(doj.getText()));
            if(manager.getText().isEmpty()){
                ps.setNull(11, Types.VARCHAR);
            }else{
                ps.setString(11, manager.getText());
            }

            ps.executeUpdate();

            JOptionPane.showMessageDialog(this,"Employee Added Successfully");

        }catch(SQLException e){

            if(e.getErrorCode() == 12899){   // 🔥 VALUE TOO LARGE

                JOptionPane.showMessageDialog(this,
                        "Street should not exceed 15 characters");

                // ✅ CLEAR ONLY STREET FIELD
                street.setText("");
                street.requestFocus();

            }
            else{
                JOptionPane.showMessageDialog(this,
                        "Insert Failed");
            }

        }
        catch(Exception e){
            JOptionPane.showMessageDialog(this,"Insert Failed");
        }
    }
