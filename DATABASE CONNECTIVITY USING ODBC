    static void updateEmployee() {
        try {
            System.out.print("Enter Employee ID to update: ");
            String id = sc.nextLine();

            if (!employeeExists(id)) {
                System.out.println("❌ Employee not found");
                return;
            }

            System.out.println("\nEnter fields to update (comma separated)");
            System.out.println("Options: name, email, age, exp, street, state, district, pincode, doj, manager");
            System.out.print("Your choice: ");

            String input = sc.nextLine().toLowerCase();
            String[] fields = input.split(",");

            StringBuilder query = new StringBuilder("UPDATE employee SET ");
            int count = 0;

            // Store values
            String name = null, email = null, street = null, state = null, district = null, managerId = null;
            Integer age = null, exp = null, pincode = null;
            Date doj = null;

            for (String field : fields) {
                field = field.trim();

                switch (field) {

                    case "name":
                        name = getValidName();
                        query.append("employee_name=?, ");
                        count++;
                        break;

                    case "email":
                        email = getValidEmail();
                        query.append("email=?, ");
                        count++;
                        break;
                        
                    case "age":
                        age = getValidInt("Age");

                        // 🔁 LOOP UNTIL VALID
                        while (age < 18 || age > 60) {
                            System.out.println("❌ Age must be between 18 and 60");
                            age = getValidInt("Age");
                        }

                        query.append("employee_age=?, ");
                        count++;
                        break;

                    case "exp":
                        exp = getValidInt("Experience");

                        // 🔥 GET CURRENT AGE (VERY IMPORTANT)
                        int currentAge = (age != null) ? age : getEmployeeAge(id);

                        // 🔁 LOOP UNTIL VALID
                        while (exp > currentAge) {
                            System.out.println("❌ Experience must be less than or equal to Age");
                            exp = getValidInt("Experience");
                        }

                        query.append("employee_exp=?, ");
                        count++;
                        break;

                   /* case "age":
                        age = getValidInt("Age");
                        query.append("employee_age=?, ");
                        count++;
                        break;

                    case "exp":
                        exp = getValidInt("Experience");
                        query.append("employee_exp=?, ");
                        count++;
                        break;*/

                    case "street":
                        street = getValidText("Street");
                        query.append("address_street=?, ");
                        count++;
                        break;

                    case "state":
                        state = getValidText("State");
                        query.append("address_state=?, ");
                        count++;
                        break;

                    case "district":
                        district = getValidText("District");
                        query.append("address_district=?, ");
                        count++;
                        break;

                    case "pincode":
                        pincode = getValidPincode();
                        query.append("address_pincode=?, ");
                        count++;
                        break;

                    case "doj":
                        doj = getValidDate();
                        query.append("date_of_joining=?, ");
                        count++;
                        break;

                    case "manager":
                        managerId = getValidManagerId(id);
                        query.append("manager_id=?, ");
                        count++;
                        break;

                    default:
                        System.out.println("⚠️ Invalid field: " + field);
                }
            }

            if (count == 0) {
                System.out.println("❌ No valid fields selected");
                return;
            }

            // remove last comma
            query.setLength(query.length() - 2);

            query.append(" WHERE employee_id=?");

            PreparedStatement ps = con.prepareStatement(query.toString());

            int index = 1;

            // Set values in same order
            for (String field : fields) {
                field = field.trim();

                switch (field) {

                    case "name": ps.setString(index++, name); break;
                    case "email": ps.setString(index++, email); break;
                    case "age": ps.setInt(index++, age); break;
                    case "exp": ps.setInt(index++, exp); break;
                    case "street": ps.setString(index++, street); break;
                    case "state": ps.setString(index++, state); break;
                    case "district": ps.setString(index++, district); break;
                    case "pincode": ps.setInt(index++, pincode); break;
                    case "doj": ps.setDate(index++, doj); break;

                    case "manager":
                        if (managerId == null)
                            ps.setNull(index++, Types.VARCHAR);
                        else
                            ps.setString(index++, managerId);
                        break;
                }
            }

            ps.setString(index, id);

            int rows = ps.executeUpdate();

            if (rows > 0)
                System.out.println("✅ Employee Updated Successfully");
            else
                System.out.println("❌ Update failed");

        } catch (SQLException e) {

            String msg = e.getMessage();

            if (msg.contains("EMP_AGE_CHK")) {
                System.out.println("❌ Update failed: Age must be between 18 and 60");
            }
            else if (msg.contains("EMP_EXP_CHK")) {
                System.out.println("❌ Update failed: Experience must be less than or equal to Age");
            }
            else if (msg.contains("EMP_EMAIL_UNIQUE")) {
                System.out.println("❌ Update failed: Email already exists");
            }
            else if (msg.contains("EMP_ID_CHK")) {
                System.out.println("❌ Update failed: Employee ID must start with EMP");
            }
            else {
                System.out.println("❌ Update failed");
            }
        }/*catch (Exception e) {
            e.printStackTrace();
        }*/
    }
