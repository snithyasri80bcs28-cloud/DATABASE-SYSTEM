        table = new JTable(model);

        add(new JScrollPane(table), BorderLayout.CENTER);

        // 🔹 ACTIONS
        search.addActionListener(e -> searchEmployee());
        back.addActionListener(e -> { dispose(); new EmployeeMainUI(); });

        setVisible(true);
    }

    // 🔥 SEARCH WITH VALIDATION
    void searchEmployee(){

        String empId = id.getText().trim();

        // ❌ VALIDATION
        if(!empId.matches("EMP\\d+")){
            JOptionPane.showMessageDialog(this,
                "❌ Invalid ID!\nFormat must be: EMP followed by numbers (e.g., EMP101)");
            return;
        }

        try{
            Connection con = DBConnection.getConnection();

            String sql = "SELECT * FROM employee WHERE employee_id = ?";
            PreparedStatement ps = con.prepareStatement(sql);
            ps.setString(1, empId);

            ResultSet rs = ps.executeQuery();

            model.setRowCount(0);
            model.setColumnCount(0);

            ResultSetMetaData md = rs.getMetaData();
            int col = md.getColumnCount();

            for(int i=1; i<=col; i++)
                model.addColumn(md.getColumnName(i));

            // ❌ NOT FOUND
            if(!rs.next()){
                JOptionPane.showMessageDialog(this, "❌ Employee not found");
                return;
            }

            // ✅ DISPLAY DATA
            do{
                Object[] row = new Object[col];
                for(int i=1; i<=col; i++)
                    row[i-1] = rs.getObject(i)==null ? "" : rs.getObject(i);

                model.addRow(row);

            } while(rs.next());

        }catch(Exception e){
            JOptionPane.showMessageDialog(this,"❌ Search failed");
            e.printStackTrace();
        }
    }
}

