        JButton search = new JButton("Search");
        JButton back = new JButton("Back");

        top.setBorder(BorderFactory.createEmptyBorder(10,10,10,10));

        top.add(new JLabel("Employee ID (EMPxxx):"));
        top.add(id);
        top.add(search);
