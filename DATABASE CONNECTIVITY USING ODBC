    // 🔍 Check Employee
    void checkEmployee() {
    	  resetFields();

        if (!id.getText().matches("EMP\\d+")) {
            JOptionPane.showMessageDialog(this,
                    "Employee ID must be EMP followed by numbers");
            id.setText("");
            return;
        }

        try {
            Connection con = DBConnection.getConnection();

            PreparedStatement ps = con.prepareStatement(
                    "select * from employee where employee_id=?");

            ps.setString(1, id.getText());

            ResultSet rs = ps.executeQuery();

            if (!rs.next()) {
                JOptionPane.showMessageDialog(this,
                        "No employee found with this ID");
                id.setText("");
                return;
            }

            JOptionPane.showMessageDialog(this,
                    "Employee Found! Select fields to update");

            updateBtn.setEnabled(true);

        } catch (Exception e) {
            JOptionPane.showMessageDialog(this,
                    "Error checking employee");
        }
    }

    // ✏️ Update Employee
    void updateEmployee() {

        try {
            Connection con = DBConnection.getConnection();

            StringBuilder query = new StringBuilder("update employee set ");
            ArrayList<Object> values = new ArrayList<>();

            // NAME
            if (nameChk.isSelected()) {
                if (!name.getText().matches("[A-Za-z ]+")) {
                    JOptionPane.showMessageDialog(this, "Name alphabets only");
                    name.setText("");
                    name.requestFocus();
                    return;
                }
                query.append("employee_name=?,");
                values.add(name.getText());
            }

            // EMAIL
            if (emailChk.isSelected()) {
                if (!email.getText().matches("^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$")) {
                    JOptionPane.showMessageDialog(this, "Invalid Email");
                    email.setText("");
                    email.requestFocus();
                    return;
                }
                query.append("email=?,");
                values.add(email.getText());
            }

            // STATE
            if (stateChk.isSelected()) {
                if (!state.getText().matches("[A-Za-z ]+")) {
                    JOptionPane.showMessageDialog(this, "State alphabets only");
                    state.setText("");
                    state.requestFocus();
                    return;
                }
                query.append("address_state=?,");
                values.add(state.getText());
            }

            // DISTRICT
            if (districtChk.isSelected()) {
                if (!district.getText().matches("[A-Za-z ]+")) {
                    JOptionPane.showMessageDialog(this, "District alphabets only");
                    district.setText("");
                    district.requestFocus();
                    return;
                }
                query.append("address_district=?,");
                values.add(district.getText());
            }

            // PINCODE
            if (pinChk.isSelected()) {
                if (!pincode.getText().matches("\\d{6}")) {
                    JOptionPane.showMessageDialog(this,
                            "Pincode must be 6 digits");
                    pincode.setText("");
                    pincode.requestFocus();
                    return;
                }
                query.append("address_pincode=?,");
                values.add(Integer.parseInt(pincode.getText()));
            }

            // No selection
            if (values.isEmpty()) {
                JOptionPane.showMessageDialog(this,
                        "Select at least one field");
                return;
            }

            // Remove last comma
            query.deleteCharAt(query.length() - 1);

            query.append(" where employee_id=?");
            values.add(id.getText());

            PreparedStatement ps = con.prepareStatement(query.toString());

            for (int i = 0; i < values.size(); i++) {
                ps.setObject(i + 1, values.get(i));
            }

            ps.executeUpdate();

            JOptionPane.showMessageDialog(this,
                    "Employee Updated Successfully");

        } catch (SQLException e) {

            if (e.getErrorCode() == 1) {   // ORA-00001 duplicate

                JOptionPane.showMessageDialog(this,
                        "Duplicate Email is not allowed");

                // ✅ SAME LIKE NAME FIELD
                email.setText("");
                email.requestFocus();

            } else {
                JOptionPane.showMessageDialog(this,
                        "Update failed");
            }
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this,
                    "Update failed");
        }
    }
}

