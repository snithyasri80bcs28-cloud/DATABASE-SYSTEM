        setLocationRelativeTo(null);

        id=new JTextField();

        add(new JLabel("Employee ID"));
        add(id);

        JButton delete=new JButton("Delete");
        JButton back=new JButton("Back");

        add(delete);
        add(back);

        delete.addActionListener(e->deleteEmployee());
        back.addActionListener(e->{dispose(); new EmployeeMainUI();});

        setVisible(true);
    }

    void deleteEmployee(){

        // 1. Validate ID format
        if(!id.getText().matches("EMP\\d+")){
            JOptionPane.showMessageDialog(this,
                    "Employee ID must be CAPITAL EMP followed by numbers");
            id.setText("");
            return;
        }

        try{
            Connection con=DBConnection.getConnection();

            // 2. Check employee exists
            PreparedStatement check=con.prepareStatement(
                    "select * from employee where employee_id=?");
            check.setString(1,id.getText());

            ResultSet rs=check.executeQuery();

            if(!rs.next()){
                JOptionPane.showMessageDialog(this,
                        "No employee found with this ID");
                id.setText("");
                return;
            }

            // 3. Check if employee is manager
            PreparedStatement managerCheck=con.prepareStatement(
                    "select * from employee where manager_id=?");
            managerCheck.setString(1,id.getText());

            ResultSet rsManager=managerCheck.executeQuery();

            if(rsManager.next()){
                JOptionPane.showMessageDialog(this,
                        "This employee is manager for other employees. Cannot delete.");
                return;
            }

            // 4. Delete employee
            PreparedStatement delete=con.prepareStatement(
                    "delete from employee where employee_id=?");
            delete.setString(1,id.getText());

            delete.executeUpdate();

            JOptionPane.showMessageDialog(this,"Employee Deleted Successfully");
            id.setText("");

        }catch(SQLIntegrityConstraintViolationException e){
            JOptionPane.showMessageDialog(this,
                    "Employee associated with other domains. Cannot delete.");

        }catch(Exception e){
            JOptionPane.showMessageDialog(this,"Delete Failed");
        }
    }
}

